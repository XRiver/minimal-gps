# 复制本文件为 keystore.properties 并填入你自己的密钥信息。
# keystore.properties 已被 .gitignore 排除，不要把它提交上去。
#
# 生成密钥库（有效期 10000 天，覆盖 Google Play 的年限要求）：
#   keytool -genkeypair -v -keystore keystore/release.jks \
#     -alias <你的别名> -keyalg RSA -keysize 4096 -validity 10000 \
#     -storepass <口令> -keypass <口令> \
#     -dname "CN=..., O=..., C=CN"
#
# 注意：以后覆盖安装更新必须用同一个密钥，否则系统会拒绝安装。
# 这个文件不存在时 release 仍可构建，只是产出未签名包（无法直接安装）。

storeFile=keystore/release.jks
storePassword=在此填入
keyAlias=在此填入
keyPassword=在此填入
